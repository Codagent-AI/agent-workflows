{
  "name": "define-openspec-change-server",
  "version": "0.1.0",
  "private": true,
  "description": "Tool server for the define-openspec-change plugin. Bundled into ../plugin/server.mjs.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint --error-on-warnings . && jscpd",
    "test": "rm -rf build && tsc -p tsconfig.test.json && node --test --test-concurrency=4 \"build/test/*.test.js\"",
    "check": "npm run typecheck && node scripts/build.mjs --check && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "yaml": "2.9.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.3",
    "@types/node": "22.20.5",
    "esbuild": "0.25.12",
    "jscpd": "4.3.0",
    "typescript": "5.9.3"
  }
}
