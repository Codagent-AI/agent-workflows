{
  "name": "define-openspec-change-server",
  "version": "0.1.0",
  "private": true,
  "description": "Tool server for the define-openspec-change plugin. Bundled into ../plugin/server.mjs.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint --error-on-warnings . && jscpd",
    "test": "rm -rf build && tsc -p tsconfig.test.json && node --test --test-concurrency=4 \"build/test/*.test.js\"",
    "check": "npm run typecheck && node scripts/build.mjs --check && npm test",
    "lint:ci": "npm ci --no-audit --no-fund --silent && npm run lint",
    "check:ci": "npm ci --no-audit --no-fund --silent && npm run check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "jscpd": "5.4.3",
    "typescript": "7.0.2"
  }
}
